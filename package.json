{
  "name": "demo-api-aws",
  "version": "1.0.0",
  "description": "Pokédex API (consume la PokeAPI) de ejemplo para el TP: AWS para aplicaciones Node.js",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:proxy": "node --use-system-ca src/server.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
